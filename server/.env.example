PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://127.0.0.1:27017/code_jigsaw
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_this_with_a_long_random_secret_key_2026

# Admin Credentials (Auto-created on server start if missing in DB)
# IMPORTANT: Change these values in your local .env file!
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_USER_ID=admin123
ADMIN_PASSWORD=change_this_secure_password_123

# Optional: Path to custom questions JSON seed file.
# If not set, the server will look for ./data/questions.json relative to the server directory.
# SEED_FILE_PATH=/absolute/path/to/code_jigsaw_questions_1200.json
